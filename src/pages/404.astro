---
import Base from '../layouts/Base.astro';
---

<Base lang="en" title="Page not found" description="This page does not exist." noindex>
  <div class="py-16 text-center">
    <p class="text-6xl font-bold text-primary">404</p>
    <h1 class="mt-4">Page not found</h1>
    <p class="mt-2 text-base-content/60">페이지를 찾을 수 없습니다.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a class="btn btn-primary" href="/">Home</a>
      <a class="btn btn-outline" href="/ko">홈 (한국어)</a>
    </div>
  </div>
</Base>
