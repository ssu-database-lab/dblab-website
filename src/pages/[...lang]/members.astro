---
import Base from '../../layouts/Base.astro';
import { strings, langPaths, type Lang } from '../../i18n';
import members from '../../data/members.json';
import alumni from '../../data/alumni.json';

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ko = lang === 'ko';
const t = strings(lang).members;

const memberLinks = (links: Record<string, string | null>) =>
  (
    [
      ['GitHub', links.github],
      ['ORCID', links.orcid],
      ['DBLP', links.dblp],
      ['LinkedIn', links.linkedin],
    ] as const
  ).filter(([, href]) => href);

const alumniBy = (degree: string) =>
  alumni.filter((a) => a.degree === degree).sort((a, b) => b.year - a.year);
const alumniGroups = [
  { label: t.phd, people: alumniBy('PhD') },
  { label: t.ms, people: alumniBy('MS') },
];
---

<Base lang={lang} title={t.title} description={t.description}>
  <h1>{t.title}</h1>

  <section class="mt-10">
    <h2 class="section-title">{t.students}</h2>
    <div class="grid gap-6 md:grid-cols-2">
      {
        members.current.map((m) => (
          <article class="card liquid-glass">
            <div class="card-body gap-3 p-5">
              <div class="flex gap-4">
                <img
                  src={m.photo}
                  alt={ko ? m.name_kr : m.name_en}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="h-20 w-20 shrink-0 rounded-box object-cover object-[50%_20%]"
                />
                <div class="min-w-0">
                  <h3 class="text-lg font-bold leading-snug">{ko ? m.name_kr : m.name_en}</h3>
                  <p class="text-sm font-medium text-primary">{ko ? m.role_kr : m.role_en}</p>
                  <p class="mt-1 text-sm text-base-content/80">{ko ? m.interests_kr : m.interests_en}</p>
                </div>
              </div>
              <p class="text-sm text-base-content/60">{ko ? m.bio_kr : m.bio_en}</p>
              <div class="mt-auto flex flex-wrap items-center gap-2 pt-1">
                <a class="link link-primary mr-1 text-sm" href={`mailto:${m.email}`}>{m.email}</a>
                {memberLinks(m.links).map(([label, href]) => (
                  <a class="btn btn-outline btn-xs" href={href}>{label}</a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-14">
    <h2 class="section-title">{t.alumni}</h2>
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      {
        alumniGroups.map((g) => (
          <div>
            <h3 class="mb-2 text-lg font-semibold">
              {g.label} <span class="text-sm font-normal text-base-content/50">({g.people.length})</span>
            </h3>
            <ul class="divide-y divide-base-300 text-[15px]">
              {g.people.map((a) => (
                <li class="py-2.5">
                  <span class="font-semibold">{ko ? a.name_kr : a.name_en}</span>
                  <span class="text-base-content/50">
                    {' '}· {a.year}
                    {a.dept_en && ` · ${ko ? a.dept_kr : a.dept_en}`}
                  </span>
                  {(a.thesis_kr || a.thesis_en) && (
                    <span class="block text-sm text-base-content/70">
                      {ko ? a.thesis_kr : (a.thesis_en ?? a.thesis_kr)}
                    </span>
                  )}
                  {a.now && (
                    <span class="block text-sm text-base-content/50">
                      {t.now}: {a.now}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</Base>
