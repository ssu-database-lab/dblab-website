---
import Base from '../../layouts/Base.astro';
import { strings, langPaths, type Lang } from '../../i18n';
import { formatAuthors } from '../../format';
import { parseBib, toPublication } from '../../bib';
import bib from '../../data/publications.bib?raw';

export const getStaticPaths = langPaths;

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = strings(lang).publications;

const publications = parseBib(bib).map(toPublication);
const years = [...new Set(publications.map((p) => p.year))].sort((a, b) => b - a);
const byYear = years.map((y) => ({ year: y, pubs: publications.filter((p) => p.year === y) }));
---

<Base lang={lang} title={t.title} description={t.description}>
  <h1>{t.title}</h1>

  {
    byYear.map(({ year, pubs }) => (
      <section class="mt-12">
        <h2 class="section-title">
          {year} <span class="text-base font-normal text-base-content/50">({pubs.length})</span>
        </h2>
        <ol class="space-y-6">
          {pubs.map((p) => (
            <li>
              <p class="font-semibold leading-snug">{p.title}</p>
              {p.authors.length > 0 && (
                <p class="mt-1 text-[15px] text-base-content/80">{formatAuthors(p.authors, p.etal)}</p>
              )}
              <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
                <i class="text-base-content/70">{p.venue}</i>
                {p.award && <span class="badge badge-soft badge-warning badge-sm">{p.award}</span>}
                {p.links.map(([label, href]) => (
                  <a class="link link-primary" href={href}>
                    {label}
                  </a>
                ))}
              </p>
            </li>
          ))}
        </ol>
      </section>
    ))
  }

</Base>
